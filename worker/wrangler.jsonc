{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flightnotify",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets are inlined into the Worker (src/web/static-assets.ts) and
  // served from src/web/router.ts. The Workers Assets upload API returns 401
  // for this account's OAuth token; serving two small files from the Worker
  // costs a negligible slice of the free plan's 100,000 requests/day.


  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flightnotify",
      // Committed deliberately. A D1 database id is a deployment identifier,
      // not a credential: it names a database inside an account and is useless
      // without separate Cloudflare authentication. Committing it keeps deploys
      // reproducible from a clean clone. Real credentials live only in
      // `wrangler secret`, never here.
      "database_id": "3fdfa515-ccdc-4048-800f-940fc6662d09",
      "migrations_dir": "migrations"
    }
  ],

  // Off the quarter-hour on purpose: :00/:15/:30/:45 is where every cron on the
  // platform lands. Due status is derived from trackers.next_run_at, not from
  // this interval, so the interval only bounds scheduling latency.
  "triggers": {
    "crons": ["7,22,37,52 * * * *"]
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },

  "vars": {
    "APP_TIMEZONE": "America/Los_Angeles",
    "DEFAULT_CURRENCY": "USD",
    "DEFAULT_MARKET": "us",

    // Verified against this SerpApi account on 2026-08-02 with real one-adult
    // and two-adult searches. Do not re-run that experiment.
    "SERPAPI_PRICE_SCOPE": "party_total",

    "MONTHLY_SEARCH_BUDGET": "250",
    // 4% of 250 = 10 searches, matching the previous absolute
    // SERPAPI_RESERVE_SEARCHES=10. Held back so a manual "Check now" still
    // works after automation has stopped.
    "SEARCH_BUDGET_RESERVE_PERCENT": "4",
    "HOURLY_SEARCH_LIMIT": "50",
    "QUERY_CACHE_TTL_SECONDS": "900",

    // Cutover step 1 deploys with this false: the Cron Trigger is registered
    // but the handler performs no live work. Flip to "true" only after the old
    // Python scheduler is disabled.
    "SCHEDULER_ENABLED": "true",

    // Bounds work per invocation against the Free plan's 10ms CPU / 50
    // subrequest / 50 D1 query ceilings.
    "MAX_TRACKERS_PER_TICK": "2",
    "MAX_QUERIES_PER_TICK": "3",
    "SCHEDULER_LEASE_TTL_SECONDS": "300"
  }
}
