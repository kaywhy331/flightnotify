# FlightNotify configuration example.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env
#
# The application starts without any credentials and reports a truthful
# "setup required" state instead of showing sample fares.

# ---------------------------------------------------------------------------
# Airfare provider (SerpApi) - required for live searches
# ---------------------------------------------------------------------------
# Create a free account at https://serpapi.com/users/sign_up and copy the
# private API key from https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Free plan allowance verified 2026-08-01: 250 searches/month, 50/hour.
# Keep these configurable - do not assume the plan never changes.
SERPAPI_MONTHLY_SEARCH_LIMIT=250
SERPAPI_HOURLY_SEARCH_LIMIT=50
# Searches held back from automation so manual checks always remain possible.
SERPAPI_RESERVE_SEARCHES=10

# How SerpApi's Google Flights `price` field should be interpreted.
#   party_total   - price covers the whole selected passenger party (default)
#   per_traveler  - price is for one traveler
#   unknown       - do not derive per-traveler values at all
# SerpApi's documentation does not state this. `party_total` mirrors the
# Google Flights web UI. Verify against your own account with:
#   FLIGHTNOTIFY_LIVE_TESTS=1 pytest -m live \
#     tests/live/test_live_provider.py::test_price_scope_matches_the_configured_assumption
# (that check consumes provider searches).
SERPAPI_PRICE_SCOPE=party_total

# ---------------------------------------------------------------------------
# Telegram alerts - required for notifications
# ---------------------------------------------------------------------------
# 1. Open Telegram, message @BotFather, send /newbot, follow the prompts.
# 2. Copy the token it returns into TELEGRAM_BOT_TOKEN below.
# 3. Open a chat with your new bot and send /start.
# 4. Either paste the chat id below, or use Settings -> "Discover chat".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Answer commands in Telegram (/status, /trackers, /check ...) as well as
# sending alerts. Off by default: it is an inbound surface, and /check spends
# provider searches.
#
# Only TELEGRAM_CHAT_ID is ever obeyed - messages from any other chat are
# ignored without a reply - so connect the chat before enabling this.
#
# NOTE: Telegram's getUpdates has a single consumer. While the bot is running,
# Settings -> "Discover chat" cannot see messages. Discover the chat first,
# or stop the bot to re-run discovery.
BOT_ENABLED=false
# Seconds Telegram holds a poll open when there is nothing new.
BOT_POLL_TIMEOUT_SECONDS=25

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_TIMEZONE=America/Los_Angeles
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///data/flightnotify.db
DEFAULT_MARKET=us
DEFAULT_CURRENCY=USD
LOG_LEVEL=INFO

# Signing key for session cookies and CSRF tokens.
# Leave blank and FlightNotify generates one into data/secret_key (mode 0600).
# Generate your own with: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Seconds an identical provider query stays reusable from the local cache.
# SerpApi itself caches for 1h; 900s is a conservative default.
QUERY_CACHE_TTL_SECONDS=900

# Enable the in-process scheduler thread when running the web app.
SCHEDULER_ENABLED=true
# How often the scheduler wakes up to look for due trackers.
SCHEDULER_TICK_SECONDS=60
